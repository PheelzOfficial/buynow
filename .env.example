PORT=4500
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MONGO_URI=
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# Set only to the number of trusted reverse proxies in your deployment.
TRUST_PROXY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=BuyNow Admin

# Brevo transactional email API; use a sender verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BuyNow

# Swagger UI at /api/v1/docs and spec at /api/v1/openapi.json. Defaults to off when NODE_ENV=production.
API_DOCS=

# Paystack online payment. Use sk_test_... until you go live. Webhook URL: https://<host>/api/v1/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_ORDER_TTL_MINUTES=30
