{
  "name": "buynow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/check-architecture.js",
    "check": "npm run format:check && npm run architecture:check && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4"
  }
}
